# Copy to .env and fill in. Never commit the real .env.

# Postgres server (superuser is used only by the init script, never by the services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Per-service databases and users (created by the Postgres init script)
INGEST_DB_PASSWORD=change-me-ingest
ALERTS_DB_PASSWORD=change-me-alerts
INGEST_DATABASE_URL=postgresql+psycopg://ingest:change-me-ingest@postgres:5432/ingest_db
ALERTS_DATABASE_URL=postgresql+psycopg://alerts:change-me-alerts@postgres:5432/alerts_db

# Kafka
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_GROUP_ID=alert-service

# Ingest: rule engine
RULES_FILE=/app/config/rules.yaml
SIGNAL_TOLERANCE_MHZ=0.1
MAX_LATENESS_S=300
MAX_BATCH_SIZE=1000

# Alerts
SWEEP_INTERVAL_S=5

LOG_LEVEL=INFO
